# Public URL of the deployed site (used for canonical links, Open Graph and the `curl` hints).
NUXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery via Resend. Leave empty to log messages to the server console instead.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO=
NUXT_CONTACT_FROM=cv@example.com

# Set to 1 to skip fetching project READMEs from GitHub at build time.
# CV_OFFLINE=1
