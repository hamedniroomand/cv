# Public URL of the deployed site (used for canonical links, Open Graph and the `curl` hints).
NUXT_PUBLIC_SITE_URL=https://example.com

# Contact form notifications: a Discord webhook URL. Leave empty to log messages to the server console instead.
NUXT_DISCORD_WEBHOOK_URL=

# Cloudflare Turnstile for the contact form (https://dash.cloudflare.com → Turnstile). Leave both empty to
# disable the captcha. The site key is baked into the prerendered page, so set it at BUILD time; the secret is
# read at runtime. Cloudflare's test pair (always passes): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
