{
  "name": "cv",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun --bun vitest run --passWithNoTests",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:watch": "bun --bun vitest",
    "prepare": "command -v vp >/dev/null 2>&1 && vp config || exit 0",
    "icons": "bun run scripts/build-icons.ts",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "marked": "^18.0.11",
    "nuxt": "npm:nuxt-nightly@5.0.0-29807919.2cbde35e",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "h3": "2.0.1-rc.31",
    "rangi": "2.2.0",
    "typescript": "^6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2"
}
